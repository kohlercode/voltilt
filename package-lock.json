{
  "name": "voltilt",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "voltilt",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "examples/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "examples/coverflow": {
      "name": "@voltilt/example-coverflow",
      "version": "0.1.0",
      "dependencies": {
        "@voltilt/coverflow": "*"
      }
    },
    "examples/z-timeline": {
      "name": "@voltilt/example-z-timeline",
      "version": "0.1.0",
      "dependencies": {
        "@voltilt/z-timeline": "*"
      }
    },
    "node_modules/@voltilt/coverflow": {
      "resolved": "packages/coverflow",
      "link": true
    },
    "node_modules/@voltilt/example-coverflow": {
      "resolved": "examples/coverflow",
      "link": true
    },
    "node_modules/@voltilt/example-z-timeline": {
      "resolved": "examples/z-timeline",
      "link": true
    },
    "node_modules/@voltilt/z-timeline": {
      "resolved": "packages/z-timeline",
      "link": true
    },
    "packages/coverflow": {
      "name": "@voltilt/coverflow",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/z-timeline": {
      "name": "@voltilt/z-timeline",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
